    "bytes": 33645,
    "seconds": 5.805,
    "text": "Set the back trigger and the front one breaks at a whisper. Take a look. Don't take her home yet.",
    "speaker": "rich",
    "voice_id": "LNV6ahDtkAOqwn1X3R7a",
    "model_id": "eleven_v4",
    "start_seconds": 0.0
  },
