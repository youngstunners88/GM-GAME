{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "gm-game/tools/farm/registry.schema.json",
  "title": "Tool Farm Registry",
  "description": "Vetted external tooling. A tool is only usable if it has a row here. Verdict is binding.",
  "type": "object",
  "required": ["version", "evaluated_on", "tools"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "evaluated_on": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "tools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "source", "verdict", "reason", "verified"],
        "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "source": { "type": "string", "minLength": 3 },
          "kind": { "enum": ["skill", "mcp", "library", "cli", "service", "site", "unknown"] },
          "verdict": {
            "enum": ["ADOPT", "STEAL-IDEAS-ONLY", "IGNORE"],
            "description": "ADOPT = wired in. STEAL-IDEAS-ONLY = pattern copied, no dependency. IGNORE = not used."
          },
          "reason": { "type": "string", "minLength": 10 },
          "verified": {
            "type": "object",
            "required": ["installable", "method"],
            "additionalProperties": false,
            "properties": {
              "installable": { "enum": ["yes", "no", "not-attempted"] },
              "method": {
                "enum": ["ran-it-here", "fetched-page", "unverified"],
                "description": "ran-it-here is the only evidence tier that permits ADOPT."
              },
              "note": { "type": "string" }
            }
          },
          "popularity_claim": {
            "type": "string",
            "description": "UNTRUSTED. Star counts could not be verified from this container (GitHub API is scoped to our own repos). Never cite as fact."
          },
          "requires_secret": { "type": "string", "description": "Env var NAME only, never a value." },
          "license": { "type": "string" },
          "pattern_taken": { "type": "string", "description": "For STEAL-IDEAS-ONLY: what we copied instead of depending on it." }
        }
      }
    }
  }
}
