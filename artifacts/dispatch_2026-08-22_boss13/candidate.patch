+					_stuck_timer = 0.0
+				if _stuck_timer >= STUCK_TIMEOUT:
+					_stuck_timer = 0.0
+					_vault_cooldown = 3.0
+					velocity.y = HOP_VELOCITY
+					_air_hop_ready = true
+					var vault_dir: float = signf(pl.global_position.x - (global_position.x + HALF_BODY))
+					if is_zero_approx(vault_dir):
+						vault_dir = direction
+					velocity.x = patrol_speed * 1.3 * vault_dir
+			_last_progress_x = global_position.x
 			if throw_timer <= 0:
 				_throw_dynamite()
 
