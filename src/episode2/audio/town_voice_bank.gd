		"path": "res://src/episode2/extras/audio/town/town_cell_00.ogg"
	},
	"town_cell_01": {
		"speaker": "lil_blunt",
		"text": "Easy, Bam. Lil Blunt. You look like you've had a year.",
		"seconds": 4.405,
		"start_seconds": 0,
		"ready": true,
		"path": "res://src/episode2/extras/audio/town/town_cell_01.ogg"
	},
	"town_cell_02": {
		"speaker": "bam",
		"text": "Let's just say the books didn't balance. I'd sooner leave it there.",
		"seconds": 4.605,
		"start_seconds": 0,
		"ready": true,
		"path": "res://src/episode2/extras/audio/town/town_cell_02.ogg"
	},
	"town_cell_03": {
		"speaker": "lil_blunt",
		"text": "That's enough for me. No man owes me his worst day.",
		"seconds": 4.205,
		"start_seconds": 0,
		"ready": true,
		"path": "res://src/episode2/extras/audio/town/town_cell_03.ogg"
	},
	"town_cell_04": {
		"speaker": "bam",
		"text": "I used to call every dip an opportunity. Then the floor learned my name.",
		"seconds": 5.105,
		"start_seconds": 0,
		"ready": true,
		"path": "res://src/episode2/extras/audio/town/town_cell_04.ogg"
	},
	"town_cell_05": {
		"speaker": "lil_blunt",
		"text": "Floor's an honest teacher. Still, a man can get back up.",
		"seconds": 4.305,
		"start_seconds": 0,
		"ready": true,
		"path": "res://src/episode2/extras/audio/town/town_cell_05.ogg"
	},
	"town_cell_06": {
		"speaker": "bam",
		"text": "I told folks I was building a future. Turned out I was renting their patience.",
		"seconds": 5.405042,
		"start_seconds": 0,
		"ready": true,
		"path": "res://src/episode2/extras/audio/town/town_cell_06.ogg"
	},
	"town_cell_07": {
		"speaker": "lil_blunt",
		"text": "Well. You can sit quiet with me. That's a fair trade.",
		"seconds": 3.621,
		"start_seconds": 0.084,
		"ready": true,
		"path": "res://src/episode2/extras/audio/town/town_cell_07.ogg"
	},
	"town_cell_08": {
		"speaker": "bam",
		"text": "You're kind, little man. Next coin I earn, I'm counting it twice.",
		"seconds": 4.305,
		"start_seconds": 0,
		"ready": true,
		"path": "res://src/episode2/extras/audio/town/town_cell_08.ogg"
	},
	"town_cell_09": {
		"speaker": "lil_blunt",
		"text": "Count it slow, Bam. And walk softer than you talk.",
		"seconds": 4.005042,
		"start_seconds": 0,
		"ready": true,
		"path": "res://src/episode2/extras/audio/town/town_cell_09.ogg"
	},
