theme_override_colors/font_color = Color(0.29, 0.87, 0.5, 1)

[node name="S1" type="Label" parent="Panel/VBox/Scroll/Body"]
text = "A community crypto project with three linked tokens - SMOKE, DIAMONDS, and GOLD - and this game is its playground. You never need to buy anything to play."
autowrap_mode = 2
theme_override_font_sizes/font_size = 17
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_constants/line_spacing = 6

[node name="H2" type="Label" parent="Panel/VBox/Scroll/Body"]
text = "WHY CONNECT A WALLET?"
theme_override_font_sizes/font_size = 18
theme_override_colors/font_color = Color(0.29, 0.87, 0.5, 1)

[node name="S2" type="Label" parent="Panel/VBox/Scroll/Body"]
text = "To unlock cosmetic extras and verified leaderboard scores. No wallet = still fully playable. Every level is unlocked by playing, never by holding tokens."
autowrap_mode = 2
theme_override_font_sizes/font_size = 17
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_constants/line_spacing = 6

[node name="H3" type="Label" parent="Panel/VBox/Scroll/Body"]
text = "HOW DO I GET A WALLET?"
theme_override_font_sizes/font_size = 18
theme_override_colors/font_color = Color(0.29, 0.87, 0.5, 1)

[node name="S3" type="Label" parent="Panel/VBox/Scroll/Body"]
text = "1. Tap GET RABBY below and install it (browser extension or mobile).
2. Follow Rabby's setup - it shows a recovery phrase. Write it on PAPER. Never share it, not even with us.
3. Come back and press CONNECT RABBY at the menu. Done."
autowrap_mode = 2
theme_override_font_sizes/font_size = 17
theme_override_colors/font_color = Color(1, 1, 1, 1)
theme_override_constants/line_spacing = 6

[node name="H4" type="Label" parent="Panel/VBox/Scroll/Body"]
text = "IS IT SAFE?"
theme_override_font_sizes/font_size = 18
theme_override_colors/font_color = Color(0.29, 0.87, 0.5, 1)

[node name="S4" type="Label" parent="Panel/VBox/Scroll/Body"]
text = "We check what tokens you hold to unlock cosmetic perks. We NEVER ask for your private key. We NEVER request permission to spend your tokens. Your wallet address is public blockchain data - we only read it, we don't store it."
