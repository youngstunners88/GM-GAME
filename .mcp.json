{
  "mcpServers": {
    "repowise": {
      "command": "repowise",
      "args": [
        "mcp"
      ]
    },
    "gm-toolkit": {
      "command": "python3",
      "args": [
        "tools/mcp/gm_toolkit.py"
      ]
    },
    "meshy": {
      "command": "npx",
      "args": [
        "-y",
        "@meshy-ai/meshy-mcp-server@0.5.2"
      ],
      "env": {
        "MESHY_API_KEY": "${MESHY_API_KEY}"
      }
    },
    "firecrawl": {
      "command": "npx",
      "args": [
        "-y",
        "firecrawl-mcp"
      ],
      "env": {
        "FIRECRAWL_API_KEY": "${FIRECRAWL_API_KEY}"
      }
    }
  }
}